    <bpmn:messageFlow id="Flow_0cmszeq" sourceRef="Event_0k2t85y" targetRef="Event_0e58vnd" />
    <bpmn:messageFlow id="Flow_0gp7a68" sourceRef="Event_04j5s2b" targetRef="Event_0viv98k" />
    <bpmn:textAnnotation id="TextAnnotation_1efwe4g">
      <bpmn:text>ДИАГРАММА ПРОЦЕССА: Top-Up Request
Запрос на входящее пополнение с внешнего источника (me-to-me).
1. Запрос во внешний шлюз на пополнение
2. Ожидание подтверждения от внешней системы
3. Завершение
При отказе — отмена транзакции.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
