    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_1bqng3s" name="Пополнение запрошено успешно?">
      <bpmn:incoming>Flow_1tmvq0c</bpmn:incoming>
      <bpmn:outgoing>Flow_1g1es30</bpmn:outgoing>
      <bpmn:outgoing>Flow_0x0mm98</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_175yixl" name="Транзакция завершена">
      <bpmn:incoming>Flow_1g1es30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0x0mm98" name="Нет" sourceRef="Gateway_1bqng3s" targetRef="Event_179ngfd" />
    <bpmn:endEvent id="Event_179ngfd" name="Отмена транзакции">
      <bpmn:incoming>Flow_0x0mm98</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
