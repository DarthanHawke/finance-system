ENV=local

# Server
SERVER_PORT=50058
SERVER_TIMEOUT=10

# iso config path
ISO8583_CONFIG_PATH=iso8583.example.json

# Database
DB_HOST=postgres-transaction
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transaction_db
SSL_MODE=disable

# Redis
REDIS_ADDR=redis-transaction:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_TOPICS=transaction-commands
KAFKA_CONSUMER_GROUP_ID=transaction-service
KAFKA_CONSUMER_MIN_BYTES=1
KAFKA_CONSUMER_MAX_BYTES=10000000
KAFKA_CONSUMER_MAX_WAIT=500
KAFKA_CONSUMER_COMMIT_INTERVAL=1000
KAFKA_CONSUMER_SESSION_TIMEOUT=10000
KAFKA_CONSUMER_REBALANCE_TIMEOUT=60000
KAFKA_CONSUMER_START_OFFSET=-1
KAFKA_CONSUMER_CONCURRENCY=1
KAFKA_PRODUCER_TOPIC=account-commands,external-transaction-commands
KAFKA_PRODUCER_BATCH_SIZE=100
KAFKA_PRODUCER_BATCH_TIMEOUT=100
KAFKA_PRODUCER_REQUIRED_ACKS=-1
KAFKA_PRODUCER_MAX_ATTEMPTS=3
KAFKA_PRODUCER_WRITE_TIMEOUT=5000
KAFKA_DLQ_TOPIC=dlq
KAFKA_DLQ_BATCH_SIZE=10
KAFKA_DLQ_BATCH_TIMEOUT=100
KAFKA_DLQ_MAX_ATTEMPTS=1
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_INITIAL_WAIT=100
KAFKA_RETRY_MAX_WAIT=5000
KAFKA_RETRY_MULTIPLIER=2.0
KAFKA_PROCESSOR_BATCH_SIZE=100
KAFKA_PROCESSOR_HANDLE_PERIOD=100
KAFKA_CONCURRENCY=8

# Log
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=7
LOG_SOURCE=true